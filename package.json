{
  "name": "mdhere",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json --noEmit",
    "test:unit": "vitest run",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:browser": "playwright test",
    "test:launcher": "bash tests/scripts/mdhere.test.sh",
    "test:version": "node --test tests/scripts/version.test.mjs",
    "test:workflow": "node --test tests/scripts/signing-mode.test.mjs tests/scripts/workflow.test.mjs",
    "test:release": "pnpm test:version && pnpm test:workflow && bash tests/scripts/verify-bundle.test.sh",
    "licenses:write": "node scripts/licenses.mjs --write",
    "licenses:check": "node scripts/licenses.mjs --check",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "version:prepare": "node scripts/version.mjs prepare",
    "release:preflight": "node scripts/version.mjs preflight",
    "bundle:macos": "tauri build --target universal-apple-darwin --bundles dmg",
    "bundle:linux": "tauri build --target x86_64-unknown-linux-gnu --bundles appimage",
    "bundle:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "check:native": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "test": "pnpm test:unit && pnpm test:native && pnpm test:browser && pnpm test:launcher && pnpm test:release",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm check:native && pnpm licenses:check && pnpm test",
    "build": "vite build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "dompurify": "3.4.14",
    "markdown-it": "15.0.1",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "11.17.2",
    "shiki": "4.4.3",
    "svelte": "5.57.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
